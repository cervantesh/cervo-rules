{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cervantesh/cervo-rules/schemas/v3/compatibility-report.schema.json",
  "title": "CervoRules v3 Compatibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "compatible", "breaking", "warnings"],
  "properties": {
    "schema_version": { "const": "cervorules.v3.compatibility_report.v1" },
    "status": { "enum": ["compatible", "incompatible"] },
    "compatible": { "type": "boolean" },
    "breaking": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "non_breaking": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "kind"],
      "properties": {
        "severity": { "type": "string" },
        "kind": { "type": "string" },
        "operation": { "type": "string" },
        "field": { "type": "string" },
        "old": { "type": "string" },
        "new": { "type": "string" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
