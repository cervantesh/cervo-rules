{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cervantesh/cervo-rules/schemas/v3/policy-evaluation-report.schema.json",
  "title": "CervoRules v3 Policy Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "allow"],
  "properties": {
    "schema_version": { "const": "cervorules.v3.policy_evaluation_report.v1" },
    "request_id": { "type": "string" },
    "operation": { "type": "string" },
    "allow": { "type": "boolean" },
    "target": { "type": "string" },
    "executor": { "type": "string" },
    "reason": { "type": "string" },
    "diagnostics": { "type": "integer", "minimum": 0 }
  }
}
