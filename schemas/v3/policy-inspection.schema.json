{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cervantesh/cervo-rules/schemas/v3/policy-inspection.schema.json",
  "title": "CervoRules v3 Policy Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_api"],
  "properties": {
    "schema_version": { "const": "cervorules.v3.policy_inspection.v1" },
    "generated_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory", "metadata", "default_config", "validate_config"],
      "properties": {
        "factory": { "type": "boolean" },
        "metadata": { "type": "boolean" },
        "default_config": { "type": "boolean" },
        "validate_config": { "type": "boolean" },
        "build_policy_wrapper": { "const": false }
      }
    }
  }
}
